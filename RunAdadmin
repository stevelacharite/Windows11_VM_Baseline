```bat
@echo off
setlocal EnableExtensions EnableDelayedExpansion

title Windows 11 VM - Baseline Configuration v2
color 0A

set "SUCCESS=0"
set "FAILED=0"

cls
echo ============================================================
echo   WINDOWS 11 VM - BASELINE CONFIGURATION v2
echo ============================================================
echo.


:: ============================================================
:: VERIFICATION ADMINISTRATEUR
:: ============================================================

net session >nul 2>&1

if errorlevel 1 (
    echo [ECHEC] Verification administrateur
    echo.
    echo Ce script doit etre execute en tant qu'administrateur.
    echo.
    pause
    exit /b 1
)

echo [REUSSI] Verification administrateur
echo.


:: ============================================================
:: 1 - FUSEAU HORAIRE
:: ============================================================

echo [1/9] Fuseau horaire

tzutil /s "Eastern Standard Time" >nul 2>&1

if errorlevel 1 (
    echo       [ECHEC] Modification du fuseau horaire
    set /a FAILED+=1
) else (
    echo       [REUSSI] Eastern Standard Time
    set /a SUCCESS+=1
)

echo.


:: ============================================================
:: 2 - ALIMENTATION
:: ============================================================

echo [2/9] Configuration alimentation

set "BLOCKERROR=0"

powercfg /setactive SCHEME_MIN >nul 2>&1
if errorlevel 1 set "BLOCKERROR=1"

powercfg -change -monitor-timeout-ac 0 >nul 2>&1
if errorlevel 1 set "BLOCKERROR=1"

powercfg -change -standby-timeout-ac 0 >nul 2>&1
if errorlevel 1 set "BLOCKERROR=1"

powercfg -hibernate off >nul 2>&1
if errorlevel 1 set "BLOCKERROR=1"

if "!BLOCKERROR!"=="0" (
    echo       [REUSSI] Haute Performance
    echo       [REUSSI] Extinction ecran desactivee
    echo       [REUSSI] Veille desactivee
    echo       [REUSSI] Hibernation desactivee
    set /a SUCCESS+=1
) else (
    echo       [ECHEC] Une ou plusieurs modifications ont echoue
    set /a FAILED+=1
)

echo.


:: ============================================================
:: 3 - DELIVERY OPTIMIZATION
:: ============================================================

echo [3/9] Delivery Optimization

reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows\DeliveryOptimization" ^
 /v DODownloadMode ^
 /t REG_DWORD ^
 /d 0 ^
 /f >nul 2>&1

if errorlevel 1 (
    echo       [ECHEC] Impossible de desactiver le P2P
    set /a FAILED+=1
) else (
    echo       [REUSSI] P2P Delivery Optimization desactive
    set /a SUCCESS+=1
)

echo.


:: ============================================================
:: 4 - FIREWALL / ICMP
:: ============================================================

echo [4/9] Pare-feu Windows

netsh advfirewall firewall delete rule ^
 name="Autoriser ICMPv4 Echo Request" >nul 2>&1

netsh advfirewall firewall add rule ^
 name="Autoriser ICMPv4 Echo Request" ^
 dir=in ^
 action=allow ^
 protocol=icmpv4:8,any >nul 2>&1

if errorlevel 1 (
    echo       [ECHEC] Configuration ICMPv4
    set /a FAILED+=1
) else (
    echo       [REUSSI] Ping ICMPv4 autorise
    set /a SUCCESS+=1
)

echo.


:: ============================================================
:: 5 - WINDOWS SPOTLIGHT / CONSUMER CONTENT
:: ============================================================

echo [5/9] Windows Spotlight / Consumer Content

set "BLOCKERROR=0"

reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows\CloudContent" ^
 /v DisableWindowsSpotlightFeatures ^
 /t REG_DWORD /d 1 /f >nul 2>&1
if errorlevel 1 set "BLOCKERROR=1"

reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows\CloudContent" ^
 /v DisableThirdPartySuggestions ^
 /t REG_DWORD /d 1 /f >nul 2>&1
if errorlevel 1 set "BLOCKERROR=1"

reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows\CloudContent" ^
 /v DisableWindowsSpotlightOnActionCenter ^
 /t REG_DWORD /d 1 /f >nul 2>&1
if errorlevel 1 set "BLOCKERROR=1"

reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows\CloudContent" ^
 /v DisableWindowsSpotlightOnSettings ^
 /t REG_DWORD /d 1 /f >nul 2>&1
if errorlevel 1 set "BLOCKERROR=1"

reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows\CloudContent" ^
 /v DisableWindowsSpotlightWindowsWelcomeExperience ^
 /t REG_DWORD /d 1 /f >nul 2>&1
if errorlevel 1 set "BLOCKERROR=1"

reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows\CloudContent" ^
 /v DisableConsumerFeatures ^
 /t REG_DWORD /d 1 /f >nul 2>&1
if errorlevel 1 set "BLOCKERROR=1"

reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows\CloudContent" ^
 /v DisableWindowsConsumerFeatures ^
 /t REG_DWORD /d 1 /f >nul 2>&1
if errorlevel 1 set "BLOCKERROR=1"

reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows\CloudContent" ^
 /v DisableCloudOptimizedContent ^
 /t REG_DWORD /d 1 /f >nul 2>&1
if errorlevel 1 set "BLOCKERROR=1"

if "!BLOCKERROR!"=="0" (
    echo       [REUSSI] Windows Spotlight desactive
    echo       [REUSSI] Suggestions Microsoft desactivees
    echo       [REUSSI] Consumer Features desactivees
    echo       [REUSSI] Cloud Optimized Content desactive
    set /a SUCCESS+=1
) else (
    echo       [ECHEC] Une ou plusieurs strategies ont echoue
    set /a FAILED+=1
)

echo.


:: ============================================================
:: 6 - COMPTES MICROSOFT
:: ============================================================

echo [6/9] Comptes Microsoft

set "BLOCKERROR=0"

reg add "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System" ^
 /v NoConnectedUser ^
 /t REG_DWORD ^
 /d 3 ^
 /f >nul 2>&1
if errorlevel 1 set "BLOCKERROR=1"

reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows\CloudContent" ^
 /v DisableConsumerAccountStateContent ^
 /t REG_DWORD ^
 /d 1 ^
 /f >nul 2>&1
if errorlevel 1 set "BLOCKERROR=1"

if "!BLOCKERROR!"=="0" (
    echo       [REUSSI] Connexion avec compte Microsoft bloquee
    set /a SUCCESS+=1
) else (
    echo       [ECHEC] Restriction des comptes Microsoft
    set /a FAILED+=1
)

echo.


:: ============================================================
:: 7 - REMOTE DESKTOP
:: ============================================================

echo [7/9] Remote Desktop

set "BLOCKERROR=0"

reg add "HKLM\SYSTEM\CurrentControlSet\Control\Terminal Server" ^
 /v fDenyTSConnections ^
 /t REG_DWORD ^
 /d 0 ^
 /f >nul 2>&1
if errorlevel 1 set "BLOCKERROR=1"

reg add "HKLM\SYSTEM\CurrentControlSet\Control\Terminal Server\WinStations\RDP-Tcp" ^
 /v UserAuthentication ^
 /t REG_DWORD ^
 /d 1 ^
 /f >nul 2>&1
if errorlevel 1 set "BLOCKERROR=1"

netsh advfirewall firewall set rule ^
 group="Remote Desktop" ^
 new enable=Yes >nul 2>&1
if errorlevel 1 set "BLOCKERROR=1"

if "!BLOCKERROR!"=="0" (
    echo       [REUSSI] Remote Desktop active
    echo       [REUSSI] Network Level Authentication active
    echo       [REUSSI] Regles pare-feu RDP activees
    set /a SUCCESS+=1
) else (
    echo       [ECHEC] Configuration Remote Desktop
    set /a FAILED+=1
)

echo.


:: ============================================================
:: 8 - FAST STARTUP
:: ============================================================

echo [8/9] Fast Startup

reg add "HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\Power" ^
 /v HiberbootEnabled ^
 /t REG_DWORD ^
 /d 0 ^
 /f >nul 2>&1

if errorlevel 1 (
    echo       [ECHEC] Desactivation Fast Startup
    set /a FAILED+=1
) else (
    echo       [REUSSI] Fast Startup desactive
    set /a SUCCESS+=1
)

echo.


:: ============================================================
:: 9 - PARAMETRES UTILISATEUR
:: ============================================================

echo [9/9] Parametres utilisateur

set "BLOCKERROR=0"

reg add "HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\ContentDeliveryManager" ^
 /v SystemPaneSuggestionsEnabled ^
 /t REG_DWORD /d 0 /f >nul 2>&1
if errorlevel 1 set "BLOCKERROR=1"

reg add "HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\ContentDeliveryManager" ^
 /v SoftLandingEnabled ^
 /t REG_DWORD /d 0 /f >nul 2>&1
if errorlevel 1 set "BLOCKERROR=1"

reg add "HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\ContentDeliveryManager" ^
 /v SilentInstalledAppsEnabled ^
 /t REG_DWORD /d 0 /f >nul 2>&1
if errorlevel 1 set "BLOCKERROR=1"

reg add "HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\ContentDeliveryManager" ^
 /v ContentDeliveryAllowed ^
 /t REG_DWORD /d 0 /f >nul 2>&1
if errorlevel 1 set "BLOCKERROR=1"

if "!BLOCKERROR!"=="0" (
    echo       [REUSSI] Suggestions utilisateur desactivees
    echo       [REUSSI] Installation silencieuse d'apps desactivee
    echo       [REUSSI] Content Delivery desactive
    set /a SUCCESS+=1
) else (
    echo       [ECHEC] Parametres utilisateur
    set /a FAILED+=1
)

echo.


:: ============================================================
:: RESULTAT
:: ============================================================

echo ============================================================
echo   RESULTAT DE LA CONFIGURATION
echo ============================================================
echo.
echo   Blocs reussis : !SUCCESS!
echo   Blocs en echec: !FAILED!
echo.

if "!FAILED!"=="0" (
    echo   [REUSSI] Configuration Windows 11 terminee sans erreur.
) else (
    echo   [ATTENTION] Configuration terminee avec !FAILED! erreur^(s^).
)

echo.
echo   Un redemarrage est recommande.
echo ============================================================
echo.

pause
endlocal
```
