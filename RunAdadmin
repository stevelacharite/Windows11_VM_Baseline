@echo off
setlocal EnableExtensions

title Windows 11 VM - Baseline Configuration
color 0A

echo ============================================================
echo   WINDOWS 11 VM - BASELINE CONFIGURATION
echo ============================================================
echo.

:: ============================================================
:: VERIFICATION DES DROITS ADMINISTRATEUR
:: ============================================================

net session >nul 2>&1

if %errorlevel% neq 0 (
    echo.
    echo ERREUR : Ce script doit etre execute en administrateur.
    echo Clic droit ^> Executer en tant qu'administrateur.
    echo.
    pause
    exit /b 1
)

echo [OK] Droits administrateur confirmes.
echo.


:: ============================================================
:: 1 - FUSEAU HORAIRE
:: ============================================================

echo [1/9] Configuration du fuseau horaire...

tzutil /s "Eastern Standard Time"

if %errorlevel% equ 0 (
    echo [OK] Fuseau horaire : Eastern Standard Time
) else (
    echo [ERREUR] Impossible de configurer le fuseau horaire.
)

echo.


:: ============================================================
:: 2 - PLAN D'ALIMENTATION
:: ============================================================

echo [2/9] Configuration du plan d'alimentation...

REM Haute Performance
powercfg /setactive SCHEME_MIN >nul 2>&1

REM Aucun timeout ecran lorsque branche
powercfg -change -monitor-timeout-ac 0

REM Aucune mise en veille lorsque branche
powercfg -change -standby-timeout-ac 0

REM Desactive l'hibernation
powercfg -hibernate off

echo [OK] Plan Haute Performance applique.
echo [OK] Veille desactivee.
echo [OK] Hibernation desactivee.
echo.


:: ============================================================
:: 3 - DELIVERY OPTIMIZATION
:: ============================================================

echo [3/9] Configuration de Delivery Optimization...

REM Mode 0 = HTTP uniquement / aucun P2P entre postes
reg add ^
"HKLM\SOFTWARE\Policies\Microsoft\Windows\DeliveryOptimization" ^
/v DODownloadMode ^
/t REG_DWORD ^
/d 0 ^
/f >nul

echo [OK] Delivery Optimization P2P desactive.
echo.


:: ============================================================
:: 4 - PARE-FEU : ICMP / PING
:: ============================================================

echo [4/9] Configuration ICMPv4...

netsh advfirewall firewall delete rule ^
name="Autoriser ICMPv4 Echo Request" >nul 2>&1

netsh advfirewall firewall add rule ^
name="Autoriser ICMPv4 Echo Request" ^
dir=in ^
action=allow ^
protocol=icmpv4:8,any >nul

echo [OK] Ping ICMPv4 autorise.
echo.


:: ============================================================
:: 5 - WINDOWS SPOTLIGHT / CONTENU PROMOTIONNEL
:: ============================================================

echo [5/9] Desactivation du contenu promotionnel Windows...

reg add ^
"HKLM\SOFTWARE\Policies\Microsoft\Windows\CloudContent" ^
/v DisableWindowsSpotlightFeatures ^
/t REG_DWORD ^
/d 1 ^
/f >nul

reg add ^
"HKLM\SOFTWARE\Policies\Microsoft\Windows\CloudContent" ^
/v DisableThirdPartySuggestions ^
/t REG_DWORD ^
/d 1 ^
/f >nul

reg add ^
"HKLM\SOFTWARE\Policies\Microsoft\Windows\CloudContent" ^
/v DisableWindowsSpotlightOnActionCenter ^
/t REG_DWORD ^
/d 1 ^
/f >nul

reg add ^
"HKLM\SOFTWARE\Policies\Microsoft\Windows\CloudContent" ^
/v DisableWindowsSpotlightOnSettings ^
/t REG_DWORD ^
/d 1 ^
/f >nul

reg add ^
"HKLM\SOFTWARE\Policies\Microsoft\Windows\CloudContent" ^
/v DisableWindowsSpotlightWindowsWelcomeExperience ^
/t REG_DWORD ^
/d 1 ^
/f >nul

reg add ^
"HKLM\SOFTWARE\Policies\Microsoft\Windows\CloudContent" ^
/v DisableConsumerFeatures ^
/t REG_DWORD ^
/d 1 ^
/f >nul

reg add ^
"HKLM\SOFTWARE\Policies\Microsoft\Windows\CloudContent" ^
/v DisableWindowsConsumerFeatures ^
/t REG_DWORD ^
/d 1 ^
/f >nul

reg add ^
"HKLM\SOFTWARE\Policies\Microsoft\Windows\CloudContent" ^
/v DisableCloudOptimizedContent ^
/t REG_DWORD ^
/d 1 ^
/f >nul

echo [OK] Spotlight et contenu promotionnel desactives.
echo.


:: ============================================================
:: 6 - COMPTES MICROSOFT
:: ============================================================

echo [6/9] Restriction des comptes Microsoft...

REM Valeur 3 :
REM Impossible d'ajouter OU de se connecter avec un compte Microsoft.
REM A utiliser sur une VM d'entreprise avec compte local ou domaine.

reg add ^
"HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System" ^
/v NoConnectedUser ^
/t REG_DWORD ^
/d 3 ^
/f >nul

reg add ^
"HKLM\SOFTWARE\Policies\Microsoft\Windows\CloudContent" ^
/v DisableConsumerAccountStateContent ^
/t REG_DWORD ^
/d 1 ^
/f >nul

echo [OK] Comptes Microsoft bloques pour la connexion Windows.
echo.


:: ============================================================
:: 7 - RDP
:: ============================================================

echo [7/9] Configuration RDP...

REM Active Remote Desktop
reg add ^
"HKLM\SYSTEM\CurrentControlSet\Control\Terminal Server" ^
/v fDenyTSConnections ^
/t REG_DWORD ^
/d 0 ^
/f >nul

REM Network Level Authentication
reg add ^
"HKLM\SYSTEM\CurrentControlSet\Control\Terminal Server\WinStations\RDP-Tcp" ^
/v UserAuthentication ^
/t REG_DWORD ^
/d 1 ^
/f >nul

REM Active les regles pare-feu RDP
netsh advfirewall firewall set rule ^
group="Remote Desktop" ^
new enable=Yes >nul 2>&1

echo [OK] Remote Desktop active.
echo [OK] Network Level Authentication active.
echo.


:: ============================================================
:: 8 - FAST STARTUP
:: ============================================================

echo [8/9] Desactivation de Fast Startup...

reg add ^
"HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\Power" ^
/v HiberbootEnabled ^
/t REG_DWORD ^
/d 0 ^
/f >nul

echo [OK] Fast Startup desactive.
echo.


:: ============================================================
:: 9 - PARAMETRES UTILISATEUR COURANT
:: ============================================================

echo [9/9] Nettoyage des suggestions pour l'utilisateur courant...

reg add ^
"HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\ContentDeliveryManager" ^
/v SystemPaneSuggestionsEnabled ^
/t REG_DWORD ^
/d 0 ^
/f >nul

reg add ^
"HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\ContentDeliveryManager" ^
/v SoftLandingEnabled ^
/t REG_DWORD ^
/d 0 ^
/f >nul

reg add ^
"HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\ContentDeliveryManager" ^
/v SilentInstalledAppsEnabled ^
/t REG_DWORD ^
/d 0 ^
/f >nul

reg add ^
"HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\ContentDeliveryManager" ^
/v ContentDeliveryAllowed ^
/t REG_DWORD ^
/d 0 ^
/f >nul

echo [OK] Suggestions utilisateur desactivees.
echo.


